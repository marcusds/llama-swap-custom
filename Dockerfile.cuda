# llama-swap + llama.cpp (NVIDIA CUDA) built from source.
#
# Build args of interest:
#   LLAMACPP_REF   git ref to build (tag like b9495, a commit sha, or a branch)
#   LS_REPO        llama-swap git repo to build from
#   LS_REF         llama-swap git ref to build (branch, tag, or sha)
#   CUDA_VERSION   NVIDIA CUDA base image tag (e.g. 13.3.0)

ARG CUDA_VERSION=13.3.0
ARG LS_REPO=https://github.com/marcusds/llama-swap.git
ARG LS_REF=memory-budget

# ─────────────────────────────────────────────────────────────────────────
# Build stage: build llama-swap from source (our fork/branch, not a release)
# ─────────────────────────────────────────────────────────────────────────
FROM golang:1.26-bookworm AS ls-build

ARG LS_REPO
ARG LS_REF
ARG TARGETARCH=amd64

RUN apt-get update && \
    apt-get install -y git curl ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git init -q && \
    git remote add origin "${LS_REPO}" && \
    git fetch --depth=1 origin "${LS_REF}" && \
    git checkout -q FETCH_HEAD && \
    git rev-parse HEAD > /src/LLAMASWAP_GIT_SHA

RUN if [ -d ui ]; then cd ui; else cd ui-svelte; fi && npm ci && npm run build

RUN GOOS=linux GOARCH=${TARGETARCH} go build \
        -tags embed_ui \
        -ldflags="-X main.commit=$(git rev-parse --short HEAD) -X main.version=custom_$(git rev-parse --short HEAD) -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        -o /src/llama-swap .

# ─────────────────────────────────────────────────────────────────────────
# Build stage: compile llama.cpp for CUDA from source
# ─────────────────────────────────────────────────────────────────────────
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS build

ARG LLAMACPP_REF=master
# Leave empty to let cmake auto-detect all supported architectures.
# Set to e.g. "121" to target only DGX Spark / GB10 (SM 12.1). Datacenter
# Blackwell (B200/GB200) is a different family: SM 10.0/10.3, not 12.x —
# don't conflate the two, PTX from one family JITs onto the other but skips
# any arch-specific codegen and pays a JIT-compile cost at first kernel use.
ARG CUDA_ARCHITECTURES=""

# Leave empty to build the full GGML_CPU_ALL_VARIANTS set (one libggml-cpu-*.so
# per feature level, picked at runtime). Upstream's cmake covers arm64 on Linux
# too -- armv8.0 through armv9.2+SME -- not just x86, so the default is already
# a tuned build on both arches.
# Set this to e.g. "armv9.2-a+sve2+i8mm+dotprod+fp16" to instead compile one CPU
# backend hard-wired to a specific core (DGX Spark's Grace CPU: Cortex-X925/A725,
# both Armv9.2-A with SVE2). cmake rejects setting this together with
# GGML_CPU_ALL_VARIANTS, so it is one or the other.
# Only use this on an image scoped to one known CPU; it won't run elsewhere.
ARG GGML_CPU_ARM_ARCH=""

# Host compiler for the CPU backends and for nvcc. Ubuntu 24.04 ships GCC 13,
# which does not know the 'sme' -march feature the armv9.2 CPU variants use, so
# GGML_CPU_ALL_VARIANTS fails to configure on arm64 without this. Upstream's
# .devops/cuda.Dockerfile pins the same version on both arches.
ARG GCC_VERSION=14

# nvcc -compress-mode for the device code in the fatbinary (CUDA >= 12.8).
# ggml defaults this to "size", on the reasoning that the process is long-lived
# so a slower one-time decompress is worth the smaller binary. llama-swap breaks
# that assumption -- it restarts llama-server on every model swap -- so images
# pinned to a single GPU arch use "speed" instead. Measured on our arch sets
# (two representative TUs, CUDA 13.3.1):
#   one real arch  : size 998K   balance 2.7M   speed 2.7M   none 2.7M
#   all-arch fleet : size 3.0M   balance 9.5M   speed  11M   none  20M
# At one arch "speed" is byte-identical to "none" -- nothing to decompress at
# load, for a bounded cost. Across the full arch set it is 3.7x the payload, so
# the generic images keep "size" and eat the decompress.
ARG CUDA_COMPRESSION_MODE=size

RUN apt-get update && \
    apt-get install -y git cmake libssl-dev wget ca-certificates build-essential \
        gcc-${GCC_VERSION} g++-${GCC_VERSION} && \
    rm -rf /var/lib/apt/lists/*

ENV CC=gcc-${GCC_VERSION} CXX=g++-${GCC_VERSION} CUDAHOSTCXX=g++-${GCC_VERSION}

WORKDIR /app

# Shallow-clone exactly the requested ref (tag / branch / sha).
RUN git init -q && \
    git remote add origin https://github.com/ggml-org/llama.cpp.git && \
    git fetch --depth=1 origin "${LLAMACPP_REF}" && \
    git checkout -q FETCH_HEAD && \
    git rev-parse HEAD > /app/LLAMACPP_GIT_SHA

# Dynamic backends (BACKEND_DL) so the CUDA + all CPU variants are loadable
# .so files alongside the binary, matching the upstream server image layout.
# GGML_CUDA_FA_QUANTS=all replaces the deprecated GGML_CUDA_FA_ALL_QUANTS=ON;
# it needs llama.cpp >= 2026-09-09 (b10700-ish), which the fleet always is.
#
# LLAMA_BUILD_NUMBER: a --depth=1 clone makes `git rev-list --count HEAD` return
# 1, so llama-server would report itself as build 1 and tools/ui would ask the
# HF asset bucket for a nonexistent "b1" and silently fall back to whatever the
# "latest" UI is. Recover the real number from a bXXXXX ref.
RUN ARCH_FLAG="" && \
    [ -n "${CUDA_ARCHITECTURES}" ] && ARCH_FLAG="-DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCHITECTURES}" ; \
    CPU_ARCH_FLAG="-DGGML_CPU_ALL_VARIANTS=ON" && \
    [ -n "${GGML_CPU_ARM_ARCH}" ] && CPU_ARCH_FLAG="-DGGML_CPU_ARM_ARCH=${GGML_CPU_ARM_ARCH}" ; \
    BUILD_NUM_FLAG="" && \
    NUM="$(printf '%s' "${LLAMACPP_REF}" | sed -n 's/^b\([0-9]\{1,\}\)$/\1/p')" && \
    [ -n "$NUM" ] && BUILD_NUM_FLAG="-DLLAMA_BUILD_NUMBER=$NUM" ; \
    cmake -B build \
        -DGGML_NATIVE=OFF \
        -DGGML_CUDA=ON \
        -DGGML_CUDA_FA_QUANTS=all \
        -DGGML_CUDA_COMPRESSION_MODE=${CUDA_COMPRESSION_MODE} \
        -DGGML_BACKEND_DL=ON \
        -DLLAMA_BUILD_TESTS=OFF \
        ${ARCH_FLAG} \
        ${CPU_ARCH_FLAG} \
        ${BUILD_NUM_FLAG} && \
    cmake --build build --config Release -j"$(nproc)"

# Collect the binary + every shared lib it dlopens into one dir.
# llama-bench ships too: without it there is no way to benchmark the exact
# build that is running in the image.
RUN mkdir -p /app/lib && \
    find build -name "*.so*" -exec cp -P {} /app/lib \; && \
    mkdir -p /app/full && \
    cp build/bin/llama-server /app/full/ && \
    cp build/bin/llama-bench /app/full/

# ─────────────────────────────────────────────────────────────────────────
# Runtime base: slim CUDA runtime (no compiler/dev headers)
# ─────────────────────────────────────────────────────────────────────────
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04 AS base

RUN apt-get update && \
    apt-get install -y libgomp1 curl && \
    apt autoremove -y && apt clean -y && \
    rm -rf /tmp/* /var/tmp/* && \
    find /var/cache/apt/archives /var/lib/apt/lists -not -name lock -type f -delete && \
    find /var/cache -type f -delete

# ─────────────────────────────────────────────────────────────────────────
# Final image (upstream): llama-server + libs + the mostlygeek/llama-swap
# release binary
# ─────────────────────────────────────────────────────────────────────────
FROM base AS server

ARG TARGETARCH=amd64
ARG LS_VER=222
ARG LLAMACPP_REF=master
ARG BUILD_DATE=N/A
ARG CUDA_VERSION=13.3.0

LABEL org.opencontainers.image.title="llama-swap-cuda" \
      org.opencontainers.image.description="llama-swap + llama.cpp (NVIDIA CUDA) built from source" \
      org.opencontainers.image.source="https://github.com/ggml-org/llama.cpp" \
      io.llamacpp.ref="${LLAMACPP_REF}" \
      io.llamaswap.version="${LS_VER}" \
      io.cuda.version="${CUDA_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

ENV LLAMA_ARG_HOST=0.0.0.0
ENV PATH="/app:${PATH}"

# llama-server + its dlopen'd backends share /app; the binary's $ORIGIN rpath
# finds them, matching the upstream server image layout.
COPY --from=build /app/lib/ /app
COPY --from=build /app/full/llama-server /app
COPY --from=build /app/full/llama-bench /app
COPY --from=build /app/LLAMACPP_GIT_SHA /app/LLAMACPP_GIT_SHA

# Drop in the llama-swap release binary.
RUN curl -fsSL -o /tmp/ls.tar.gz \
        "https://github.com/mostlygeek/llama-swap/releases/download/v${LS_VER}/llama-swap_${LS_VER}_linux_${TARGETARCH}.tar.gz" && \
    tar -zxf /tmp/ls.tar.gz -C /app llama-swap && \
    rm /tmp/ls.tar.gz

COPY config.example.yaml /app/config.yaml

WORKDIR /app

HEALTHCHECK CMD curl -f http://localhost:8080/ || exit 1
ENTRYPOINT [ "/app/llama-swap", "-config", "/app/config.yaml", "-listen", "0.0.0.0:8080" ]

# ─────────────────────────────────────────────────────────────────────────
# Final image (fork): llama-server + libs + llama-swap built from our
# fork/branch instead of an upstream release
# ─────────────────────────────────────────────────────────────────────────
FROM base AS server-fork

ARG TARGETARCH=amd64
ARG LS_REPO=https://github.com/marcusds/llama-swap.git
ARG LS_REF=memory-budget
ARG LLAMACPP_REF=master
ARG BUILD_DATE=N/A
ARG CUDA_VERSION=13.3.0

LABEL org.opencontainers.image.title="llama-swap-cuda" \
      org.opencontainers.image.description="llama-swap + llama.cpp (NVIDIA CUDA) built from source" \
      org.opencontainers.image.source="https://github.com/ggml-org/llama.cpp" \
      io.llamacpp.ref="${LLAMACPP_REF}" \
      io.llamaswap.repo="${LS_REPO}" \
      io.llamaswap.ref="${LS_REF}" \
      io.cuda.version="${CUDA_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

ENV LLAMA_ARG_HOST=0.0.0.0
ENV PATH="/app:${PATH}"

COPY --from=build /app/lib/ /app
COPY --from=build /app/full/llama-server /app
COPY --from=build /app/full/llama-bench /app
COPY --from=build /app/LLAMACPP_GIT_SHA /app/LLAMACPP_GIT_SHA

# Drop in the llama-swap binary built from our fork/branch.
COPY --from=ls-build /src/llama-swap /app/llama-swap
COPY --from=ls-build /src/LLAMASWAP_GIT_SHA /app/LLAMASWAP_GIT_SHA

COPY config.example.yaml /app/config.yaml

WORKDIR /app

HEALTHCHECK CMD curl -f http://localhost:8080/ || exit 1
ENTRYPOINT [ "/app/llama-swap", "-config", "/app/config.yaml", "-listen", "0.0.0.0:8080" ]
